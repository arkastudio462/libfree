# ---------------------------------------------------------------------------
# libfree — contoh konfigurasi produksi
# ---------------------------------------------------------------------------
# Salin ke `.env` di server, lalu isi semua nilai rahasia. Jangan pernah
# commit `.env` yang berisi kunci atau kata sandi ke repositori.
#
#   cp .env.production.example .env
#   php artisan key:generate
#
# Setelah itu jalankan langkah build & cache di docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

APP_NAME=libfree
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://libfree.id

# Paksa URL yang dihasilkan memakai HTTPS. Matikan hanya bila aplikasi
# benar-benar disajikan lewat HTTP murni.
APP_FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# `daily` merotasi berkas dan membatasi jumlah berkas lama. Untuk container,
# gunakan `stderr` agar log dikumpulkan oleh platform.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MySQL/MariaDB direkomendasikan untuk produksi. SQLite hanya cocok untuk
# instalasi kecil dengan satu proses tulis.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=libfree
DB_USERNAME=libfree
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Session & cookie
# ---------------------------------------------------------------------------
# `redis` atau `database` sama-sama didukung. Cookie wajib Secure karena
# seluruh trafik produksi memakai HTTPS.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# Cache & queue
# ---------------------------------------------------------------------------
# Redis menghindari lock contention pada tabel cache di bawah beban baca.
# Ganti CACHE_STORE/QUEUE_CONNECTION menjadi `database` bila Redis belum ada.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Penyimpanan berkas
# ---------------------------------------------------------------------------
# Naskah dan sampul berada di disk privat `local`
# (storage/app/private) dan hanya disajikan lewat endpoint yang berotorisasi.
FILESYSTEM_DISK=local

# Opsional: simpan berkas di S3 dan gunakan untuk backup offsite.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Email (tautan atur ulang kata sandi)
# ---------------------------------------------------------------------------
# Wajib diisi: dengan MAIL_MAILER=log, email reset tidak akan pernah terkirim.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=halo@libfree.id
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# Isi dengan IP proxy (pisahkan koma) atau `*` bila proxy adalah satu-satunya
# pintu masuk. Diperlukan agar HTTPS, IP klien, dan rate limit akurat.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Backup (dipakai scripts/backup.sh, bukan oleh aplikasi)
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/libfree
BACKUP_RETENTION_DAYS=14
BACKUP_STORAGE_PATHS="storage/app/private"
# Opsional: unggah otomatis ke object storage (butuh AWS CLI).
# BACKUP_S3_URI=s3://nama-bucket/libfree

VITE_APP_NAME="${APP_NAME}"
